<?xml version="1.0" encoding="utf-8"?>
<!-- The progress bars on the Downloads widget: gold on a dim track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="3dp" /><solid android:color="#33FFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><corners android:radius="3dp" /><solid android:color="#FFC94A" /></shape></clip>
    </item>
</layer-list>
