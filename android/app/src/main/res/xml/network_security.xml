<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers are usually reached by a local address over plain http (http://192.168.1.10:2806), so that is allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
