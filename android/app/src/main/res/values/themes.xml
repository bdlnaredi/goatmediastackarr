<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown for a moment while the app starts; the Compose theme takes over after that. -->
    <style name="Theme.Goat.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.Goat</item>
    </style>
    <style name="Theme.Goat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
