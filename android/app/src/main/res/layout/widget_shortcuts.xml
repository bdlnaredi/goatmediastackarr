<?xml version="1.0" encoding="utf-8"?>
<!-- The Shortcuts widget: straight to Search, Discover, Requests or Downloads. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/k_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">
        <TextView
            android:id="@+id/k_search"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="🔍 Search"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/k_discover"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="✨ Discover"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/k_requests"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="📥 Requests"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/k_downloads"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:text="⬇ Downloads"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:maxLines="1" />
</LinearLayout>
