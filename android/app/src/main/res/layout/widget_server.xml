<?xml version="1.0" encoding="utf-8"?>
<!-- The Server widget (admins): whether every app answers, the VPN, and the fullest disk. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/s_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/s_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_server_title"
            android:textColor="#FFC94A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />
        <ImageView
            android:id="@+id/s_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:padding="4dp"
            android:contentDescription="@string/widget_refresh"
            android:src="@android:drawable/ic_popup_sync" />
    </LinearLayout>
    <TextView
        android:id="@+id/s_apps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/s_vpn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#D8D8E0"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/s_disk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#D8D8E0"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/s_when"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#8A8A96"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
