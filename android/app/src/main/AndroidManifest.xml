<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android TV: the app's rows on the home screen (Play next, New in your library). -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Android TV: no touch screen there, and the leanback launcher is optional so phones still install it. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Lets the app open Plex's sign-in page in a browser tab (Custom Tabs) on Android 11 and newer. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".GoatApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:banner="@drawable/tv_banner"
        android:networkSecurityConfig="@xml/network_security"
        android:theme="@style/Theme.Goat.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Shared to the app: a link or text (magnet, .torrent address, IMDb or TMDB page), or a .torrent file. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <!-- Opening a magnet link, or a .torrent file from a file manager or the downloads. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="magnet" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <!-- The Android TV home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- The home-screen widget: speeds and what is playing. -->
        <receiver android:name=".GoatWidget" android:exported="true" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.bdlnaredi.goatstack.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_goat" />
        </receiver>
        <!-- The second widget: coming up, and the requests. -->
        <receiver android:name=".GoatListWidget" android:exported="true" android:label="@string/widget_list_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.bdlnaredi.goatstack.LIST_REFRESH" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_list" />
        </receiver>
        <!-- Android TV's home screen reads the posters of the app's rows from here. -->
        <provider
            android:name=".PosterProvider"
            android:authorities="${applicationId}.posters"
            android:exported="true" />
        <!-- Offline: the saved videos are handed to the phone's video player through this. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.offline"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/offline_files" />
        </provider>
        <!-- More widgets: the busiest downloads with Pause all, the server (admins), and shortcuts. -->
        <receiver android:name=".DownloadsWidget" android:exported="true" android:label="@string/widget_dl_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.bdlnaredi.goatstack.DL_REFRESH" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_downloads" />
        </receiver>
        <receiver android:name=".ServerWidget" android:exported="true" android:label="@string/widget_server_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.bdlnaredi.goatstack.SERVER_REFRESH" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_server" />
        </receiver>
        <receiver android:name=".ShortcutsWidget" android:exported="true" android:label="@string/widget_shortcuts_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_shortcuts" />
        </receiver>
        <!-- Buttons on notifications (approve, decline, pause): run without opening the app. -->
        <receiver android:name=".data.NotifyAction" android:exported="false" />
    </application>
</manifest>
